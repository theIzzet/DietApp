@model IEnumerable<DietApp.Models.MessageUserListViewModel>

@{
    ViewData["Title"] = "Mesaj Gönderenler";
}

<div class="container mt-5">
    <h2>Mesaj Gönderenler</h2>
    <div class="list-group">
        @foreach (var user in Model)
        {
            <div class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                    <strong>@user.UserName</strong>
                    <p class="mb-0">@user.LastMessage</p>
                </div>
                <a href="@Url.Action("Chat", "Chat", new { selectedUserId = user.Id })" class="btn btn-primary">Chatleş</a>
            </div>
        }
    </div>
</div>