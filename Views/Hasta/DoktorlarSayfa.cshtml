@model DietApp.Entities.DiyetisyenProfile


<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@Model.User.Name @Model.User.SurName - Doktor Profili</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <style>
        .doctor-image {
            max-width: 100%;
            border-radius: 10px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
        }

        .custom-card {
            border: 1px solid #ddd;
            border-radius: 10px;
            padding: 1rem;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
        }

        .stars {
            color: #FFD700;
        }

        .review-card {
            border: 1px solid #ddd;
            border-radius: 10px;
            padding: 1rem;
            margin-bottom: 1rem;
            background-color: #f9f9f9;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
        }

        .btn-large {
            padding: 1rem 2rem;
            font-size: 1.25rem;
            border-radius: 30px;
            font-weight: bold;
        }
    </style>
</head>
<body>
    <div class="container my-5">
        <div class="row">
            <div class="col-md-8">
                <h2>@Model.User.Name @Model.User.SurName</h2>
                <p class="fs-5">
                    @Model.About
                </p>
            </div>
            <div class="col-md-4 text-center">
                <img src="@Model.ProfilePicturePath" alt="@Model.User.Name @Model.User.SurName" class="doctor-image">
            </div>
        </div>

        <hr class="my-5">

        <div class="row">
            <div class="col-md-6">
                <h3>Sertifikalar</h3>
                <div class="custom-card">
                    @if (Model.Certificates.Any())
                    {
                        <ul class="list-unstyled">
                            @foreach (var certificate in Model.Certificates)
                            {
                                <li><i class="bi bi-check-circle me-2"></i> @certificate.FilePath</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p>Henüz sertifika eklenmemiş.</p>
                    }
                </div>
            </div>
            <div class="col-md-6">
                <h3>İş Deneyimleri</h3>
                <div class="custom-card">
                    @if (Model.Experiences.Any())
                    {
                        <ul class="list-unstyled">
                            @foreach (var experience in Model.Experiences)
                            {
                                <li><i class="bi bi-briefcase me-2"></i> @experience.Description</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p>Henüz iş deneyimi eklenmemiş.</p>
                    }
                </div>
            </div>
        </div>

        <hr class="my-5">
    </div>




    <div class="card border-0 mt-3">
        <div class="card-header pb-0">
            <h4><span id="commentCount">@Model.Comments.Count()</span> kadar yorum.</h4>
        </div>
        <div class="card-body">
            @foreach (var comment in Model.Comments)
            {
                <div class="my-4 d-flex">
                    <div>
                        <div class="mb-2">
                            <h6>@comment.User.UserName</h6>
                            <span><i class="bi bi-calendar"></i> @comment.PublishedOn.ToShortDateString()</span>
                        </div>
                        @comment.CommentText
                       <div class="stars">
                @for (int i = 0; i < comment.Rating; i++)
                {
                    <span style="color: #FFD700;">★</span>
                }
                @for (int i = comment.Rating; i < 5; i++)
                {
                    <span style="color: #ccc;">★</span>
                }
            </div>
                    </div>
                </div>
            }

            <hr class="my-4" />

            <div>
                <h4>Yorum Ekle</h4>
                <form asp-action="AddComment" method="post">
                    
                    <input type="hidden" asp-for="UserId" name="DietisyenProfileId" value="@Model.Id"/>

                    <div class="mb-3">
                        <label for="CommentText" class="form-label">Yorum</label>
                        <textarea asp-for="@Model.Comments.FirstOrDefault().CommentText" name="CommentText" class="form-control" id="CommentText" rows="3"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Puan</label>
                        <div id="ratingStars" class="stars">
                            <span class="star" data-value="1">★</span>
                            <span class="star" data-value="2">★</span>
                            <span class="star" data-value="3">★</span>
                            <span class="star" data-value="4">★</span>
                            <span class="star" data-value="5">★</span>
                        </div>
                        <input type="hidden" name="Rating" id="Rating" value="5" /> <!-- Varsayılan 5 yıldız -->
                    </div>

                    <div class="mb-3">
                        <button type="submit" class="btn btn-primary">Kaydet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const stars = document.querySelectorAll(".star");
            const ratingInput = document.getElementById("Rating");

            stars.forEach(star => {
                star.addEventListener("click", function () {
                    const value = this.getAttribute("data-value");
                    ratingInput.value = value;

                    
                    stars.forEach(s => s.style.color = "#ccc");

                    
                    for (let i = 0; i < value; i++) {
                        stars[i].style.color = "#FFD700";
                    }
                });
            });
        });
    </script>

    <style>
        .stars {
            font-size: 24px;
            cursor: pointer;
        }

        .star {
            color: #ccc;
            transition: color 0.3s;
        }

            .star:hover {
                color: #FFD700;
            }
    </style>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

