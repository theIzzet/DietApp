@model IEnumerable<DietApp.Entities.DiyetisyenProfile>

@{
    ViewData["Title"] = "Hizmet Sayfa";
    var doktorListesi = Model.ToList();
    int doktorSayisi = doktorListesi.Count;
    int grupSayisi = (int)Math.Ceiling(doktorSayisi / 3.0);
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Diet / Hizmet Detay</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />

    <style>
        /* Carousel butonlarını büyüt ve belirgin hale getir */
        .carousel-control-prev, .carousel-control-next {
            width: 5%;
        }

        .carousel-control-prev-icon, .carousel-control-next-icon {
            background-color: rgba(0, 0, 0, 0.7); /* Arka plan rengi */
            border-radius: 50%; /* Yuvarlak ikon */
            padding: 20px;
        }

        /* Hover efekti */
        .carousel-control-prev:hover .carousel-control-prev-icon,
        .carousel-control-next:hover .carousel-control-next-icon {
            background-color: rgba(0, 0, 0, 1);
        }

        /* Doktor görsellerini ortala */
        .doctor-image img {
            width: 100%;
            height: auto;
            border: 3px solid #007bff;
            border-radius: 10px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }
    </style>
</head>
<body>

    <div class="container my-5">
        <h2 class="text-center mb-4">Bu Alanda Uzman Diyetisyenler / Doktorlar</h2>

        @if (doktorSayisi == 0)
        {
            <div class="alert alert-info text-center">
                Bu diyet türüne ait henüz bir diyetisyen bulunmamaktadır.
            </div>
        }
        else
        {
            <div id="doctorCarousel" class="carousel slide position-relative" data-bs-ride="carousel">
                <div class="carousel-indicators">
                    @for (int i = 0; i < grupSayisi; i++)
                    {
                        <button type="button" data-bs-target="#doctorCarousel" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")" aria-label="Slide @(i + 1)"></button>
                    }
                </div>

                <div class="carousel-inner">
                    @for (int i = 0; i < grupSayisi; i++)
                    {
                        <div class="carousel-item @(i == 0 ? "active" : "")">
                            <div class="row text-center">
                                @foreach (var doktor in doktorListesi.Skip(i * 3).Take(3))
                                {
                                    <div class="col-md-4 mb-3">
                                        <div class="card h-100 shadow border-0">
                                            <div class="doctor-image mt-3">
                                                <img src="@doktor.ProfilePicturePath" class="img-fluid rounded" alt="@doktor.User.Name @doktor.User.SurName">
                                            </div>
                                            <div class="card-body">
                                                <h5 class="card-title">@doktor.User.Name @doktor.User.SurName</h5>
                                                <p class="card-text">@doktor.About</p>
                                            </div>
                                            <div class="card-footer text-end bg-white border-0">
                                                <a asp-controller="Hasta" asp-action="DoktorlarSayfa" asp-route-id="@doktor.UserId" class="btn btn-primary btn-custom">Profil Görüntüle</a>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>

                <button class="carousel-control-prev" type="button" data-bs-target="#doctorCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Önceki</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#doctorCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Sonraki</span>
                </button>
            </div>
        }
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>